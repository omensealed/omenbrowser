# OMENbrowser_rs does not require environment variables for normal use.
# Copy this file to `.env` only for local development overrides.

# Rust logging filter for development runs.
RUST_LOG=omenbrowser_rs=info,omenchatd=info,warn

# Optional Iced renderer/backend override while debugging graphics issues.
# ICED_BACKEND=wgpu

# Optional isolated browser app roots for local multi-client testing.
OMENBROWSER_ALPHA_ROOT=/tmp/omenbrowser-rs-alpha
OMENBROWSER_ALPHA_ROOT_2=/tmp/omenbrowser-rs-alpha-2

# Optional isolated standalone OMENchat server home for local testing.
OMENCHATD_ALPHA_HOME=/tmp/omenchatd-alpha
