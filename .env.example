# OMENbrowser_rs does not require environment variables for normal use.
# Copy this file to `.env` only for local development overrides.

# Rust logging filter for development runs.
RUST_LOG=omenbrowser_rs=info,omenchatd=info,warn

# Optional Iced renderer/backend override while debugging graphics issues.
# ICED_BACKEND=wgpu

# Optional isolated browser app roots for local multi-client testing.
OMENBROWSER_RELEASE_ROOT=/tmp/omenbrowser-rs-test
OMENBROWSER_RELEASE_ROOT_2=/tmp/omenbrowser-rs-test-2

# Optional isolated standalone OMENchat server home for local testing.
OMENCHATD_RELEASE_HOME=/tmp/omenchatd-test

# Optional GitHub automation credentials for local scripts.
# Do not commit a real token in `.env`; `.env` is ignored on purpose.
GITHUB_USER=omensealed
GITHUB_TOKEN="FILL_TOKEN_HERE"
TEST_PROPAGATION="PROPAGATION_NODE_ADDRESS"
TEST_GATEWAY="your_gateway_ip_here"
TEST_GATEWAY_PORT="4242"
TEST_GATEWAY_IFAC="your_private_ret" # Optional 
TEST_GATEWAY_PASSWORD="your_ifac_password" # Optional
